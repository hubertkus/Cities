@model City

<h2>Dodaj miasto</h2>

<form asp-action="Create" method="post">

 <div class="mb-3">
  <label class="form-label">Nazwa</label>
  <input asp-for="Name" class="form-control"/>
 </div>

 <div class="mb-3">
  <label class="form-label">Państwo</label>
  <input asp-for="Country" class="form-control"/>
 </div>

 <div class="mb-3">
  <label class="form-label">Populacja</label>
  <input asp-for="Population" class="form-control"/>
 </div>

 <button type="submit" class="btn btn-primary">Dodaj</button>
 <button type="reset" class="btn btn-primary">Wyczyść</button>
 <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Anuluj</a>

</form>