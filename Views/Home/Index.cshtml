@model IEnumerable<City>
@{
    ViewData["Title"] = "Miasta";
}

<h2>Lista miast</h2>

<table class="table table-striped table-bordered table-hover">
 <thead class="table-dark">
  <tr>
   <th>Nazwa</th>
   <th>Kraj</th>
   <th>Populacja</th>
  </tr>
 </thead>
 <tbody>
   @foreach (var c in Model)
   {
    <tr>
     <td>@c.Name</td>
     <td>@c.Country</td>
     <td>@c.Population</td>
    </tr>
   }
 </tbody> 
</table>

<div>
 <a asp-controller="Home" asp-action="Create" class="btn btn-primary">Dodaj miasto</a>
</div>
