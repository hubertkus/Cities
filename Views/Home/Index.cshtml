@model IEnumerable<City>
@{
    ViewData["Title"] = "Miasta";
}

<table>
 <thead>
  <th>Nazwa</th><th>Kraj</th><th>Populacja</th>
 </thead>
 <tbody>
   @foreach (var c in Model)
   {
    <tr>
     <td>@c.Name</td><td>@c.Country</td><td>@c.Population</td>
    </tr>
   }
 </tbody> 
</table>

<div>
 <a asp-controller="Home" asp-action="Create">DODAJ MIASTO</a>
</div>
